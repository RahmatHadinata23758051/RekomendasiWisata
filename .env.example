# ML Engine / Pipeline Configuration (loaded by Model/ and Scraping/ code)

# Optional custom path to the crowdsourced catalog overlay.
# When unset, the code resolves Data/consolidated/approved_catalog_submissions.json
# relative to the Model/ package, which survives launches from other directories.
# CATALOG_SUBMISSIONS_PATH=Data/consolidated/approved_catalog_submissions.json

# Trello pipeline monitoring credentials (present in the local .env; no pipeline
# code reads them today — kept for reference only)
# TRELLO_API_KEY=your_trello_api_key
# TRELLO_TOKEN=your_trello_token
# TRELLO_BOARD_ID=your_trello_board_id
# TRELLO_BOARD_URL=https://trello.com/b/your_board_id/your_board_name
